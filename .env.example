# 对外访问端口与时区
APP_PORT=8080
TZ=Asia/Hong_Kong

# web 容器直连时保持默认值。放在 1Panel OpenResty 等 HTTPS 代理后时，先把 APP_BIND_ADDRESS
# 改为宿主机明确的 loopback/私网地址并用防火墙阻止客户端绕过代理，再只信任 web 访问日志中
# 看到的即时代理源 IP（或最窄的隔离代理网段）。禁止使用 0.0.0.0/0 或 ::/0。
APP_BIND_ADDRESS=0.0.0.0
WEB_TRUST_PROXY_HEADERS=false
WEB_TRUSTED_PROXY_CIDR=127.0.0.1/32

# 数据库只支持外部 PostgreSQL。请先在数据库服务商创建空白专用数据库和非 superuser 业务用户，
# 再通过首次安装向导填写连接信息；数据库密码不要写入此文件。
# 新部署保持 UNCONFIGURED；安装成功后连接信息保存在 database_config 卷。
NAV_DATABASE_SOURCE=UNCONFIGURED
# 通过 HTTP 在受信任局域网提交数据库凭据时才可显式开启；公网部署必须保持 false 并使用 HTTPS。
NAV_ALLOW_INSECURE_DATABASE_SETUP=false
NAV_DATABASE_TICKET_TTL_SECONDS=300
NAV_DATABASE_AUTO_RESTART=true

# 可选：隔离恢复或回滚时切换到新的命名卷，默认值与正式环境固定名称一致
UPLOADS_VOLUME_NAME=xydh-nav_uploads_data
LOGS_VOLUME_NAME=xydh-nav_backend_logs
DATABASE_CONFIG_VOLUME_NAME=xydh-nav_database_config

# 可选：固定或回滚 web/后端镜像；保留 build 配置时也可由 Compose 重新构建
BACKEND_IMAGE=xydh-nav-backend:latest
WEB_IMAGE=xydh-nav-web:latest

# Redis 只连接外部服务，不由本项目创建容器或数据卷。
# 公网或跨主机连接默认使用 TLS；只有受信任私网测试才显式改为 false。
REDIS_HOST=
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DATABASE=0
REDIS_SSL_ENABLED=true
REDIS_CONNECT_TIMEOUT=3s
REDIS_READ_TIMEOUT=3s

# JWT 至少使用 32 字节随机字符串；建议通过密码管理器生成
JWT_SECRET=
# 修改 APP_PORT 时，请同步调整下方允许跨域来源的端口
JWT_EXPIRATION_MINUTES=120
# 生产环境默认关闭 Swagger/OpenAPI；仅在受控环境临时开启
OPENAPI_ENABLED=false
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# 新部署默认使用网页安装向导；确认空库后由后端打包的权威 schema 完成初始化
NAV_BOOTSTRAP_ENABLED=false
NAV_DEMO_DATA_ENABLED=false
# 网页安装入口。新部署必须预先生成 64 位小写十六进制随机口令，例如：
# openssl rand -hex 32
# 空值或弱口令会让新库保持 NOT_READY；口令永远不会由接口或日志返回。
NAV_WEB_INSTALL_ENABLED=true
NAV_INSTALL_TOKEN=
# 仅当 NAV_BOOTSTRAP_ENABLED=true 时使用的传统环境变量引导方式
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# 前端生产构建使用同源 API 地址
VITE_API_BASE_URL=/api

# 后台上传背景图的单文件大小上限（字节，默认 10MB）
APP_UPLOAD_MAX_BYTES=10485760
# 背景图片存储总量、文件数以及孤儿文件回收策略
APP_UPLOAD_MAX_TOTAL_BYTES=1073741824
APP_UPLOAD_MAX_FILES=500
APP_UPLOAD_ORPHAN_GRACE_MS=86400000
APP_UPLOAD_CLEANUP_INTERVAL_MS=21600000
APP_UPLOAD_CLEANUP_INITIAL_DELAY_MS=60000

# 可选 JVM 参数
JAVA_OPTS=-XX:MaxRAMPercentage=75.0 -Dfile.encoding=UTF-8
